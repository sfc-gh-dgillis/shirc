# Iceberg Environment Configuration Template
# Copy this file to iceberg.env and fill in your values
# 
# Usage:
#   cp .env/iceberg.env.template .env/iceberg.env
#   # Then edit .env/iceberg.env with your actual values

# ################################################
# Storage Mode
# ################################################
# Controls where Iceberg table data is stored:
#   "managed"  - Snowflake Managed Storage (no AWS setup needed, default)
#   "external" - Your own AWS S3 bucket (requires AWS Configuration below)
STORAGE_MODE=managed

# ################################################
# Snowflake Connection
# ################################################

# Snowflake CLI connection name (from ~/.snowflake/connections.toml)
CLI_CONNECTION_NAME=my_snowflake_connection

# ################################################
# Warehouse
# ################################################

DEMO_WAREHOUSE_NAME=COMPUTE_WH

# ################################################
# Database
# ################################################

# Medallion schemas (BRONZE/SILVER/GOLD) are created inside this database.
DEMO_DATABASE_NAME=yourdbnamehere
DEMO_DATABASE_DDL_COMMENT=Iceberg V3 demo database

# ################################################
# Schemas (Medallion Architecture)
# ################################################

# Schema names only — do NOT include the database prefix.
DEMO_SCHEMA_NAME_BRONZE=RAW
DEMO_SCHEMA_NAME_SILVER=CURATED
DEMO_SCHEMA_NAME_GOLD=ANALYTICS
DEMO_POLICIES_SCHEMA_NAME=POLICIES

# ################################################
# Roles & Users
# ################################################

# These will be created if they do not already exist.
DEMO_ENGINEER_ROLE_NAME=V3_DEMO_ICEBERG_ENGINEER_ROLE
DEMO_ANALYST_ROLE_NAME=FLEET_ANALYST
DEMO_ADMIN_ROLE_NAME=FLEET_ADMIN

# ################################################
# Internal Stage
# ################################################

# Bare name only (no @ prefix, no database/schema qualifier).
# The fully qualified path is composed automatically from DEMO_DATABASE_NAME + DEMO_SCHEMA_NAME_BRONZE + this value.
DEMO_INTERNAL_NAMED_STAGE=yourstagename
DEMO_INTERNAL_NAMED_STAGE_COMMENT=Internal stage for JSON file uploads

# ################################################
# File Format
# ################################################

DEMO_JSON_FILE_FORMAT=JSON_FORMAT
DEMO_JSON_FILE_FORMAT_COMMENT=JSON file format for log ingestion

# ################################################
# External Access Integration
# ################################################

# Network rule and integration for notebook Python code calling external APIs.
DEMO_NETWORK_RULE_NAME=OPEN_METEO_NETWORK_RULE
DEMO_NETWORK_RULE_HOST=api.open-meteo.com:443
DEMO_EXTERNAL_ACCESS_INTEGRATION_NAME=OPEN_METEO_ACCESS
DEMO_EXTERNAL_ACCESS_INTEGRATION_COMMENT=External access for Open-Meteo weather API

# ################################################
# Replication & Network Policy (fleet analytics demo)
# ################################################

DEMO_REPLICATION_GROUP_NAME=FLEET_ANALYTICS_REPLICATION
DEMO_NETWORK_POLICY_NAME=FLEET_STREAMING_POLICY
DEMO_INGRESS_NETWORK_RULE_NAME=FLEET_STREAMING_NETWORK_RULE

# ################################################
# Cortex Agent / Semantic View
# ################################################

# Semantic view (created in DEMO_SCHEMA_NAME_GOLD). Powers the Cortex Agent.
DEMO_SEMANTIC_VIEW_NAME=FLEET_ANALYTICS_SV

# Cortex Agent name (created in DEMO_SCHEMA_NAME_GOLD). Requires Enterprise edition.
DEMO_AGENT_NAME=FLEET_ANALYTICS_AGENT

# ################################################
# External Volume (only required when STORAGE_MODE=external)
# ################################################

EXTERNAL_VOLUME_NAME=my_iceberg_ext_vol

# ################################################
# AWS Configuration (only required when STORAGE_MODE=external)
# ################################################

# AWS Profile (optional)
# If set, this profile will be used for AWS CLI commands.
# If not set, uses default AWS credential chain (environment vars → default profile → IAM role).
# To list available profiles: aws configure list-profiles
#AWS_PROFILE=

# AWS Region for S3 and other AWS services
# Valid regions: us-east-1, us-east-2, us-west-1, us-west-2, eu-west-1, etc.
# See: https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/using-regions-availability-zones.html
AWS_REGION=us-east-1

# AWS S3 Bucket for Iceberg tables
S3_BUCKET_NAME=shirc-dev

# AWS S3 Folder for Iceberg data
# Subfolder within the bucket for organizing Iceberg tables
S3_PREFIX=snowflake-iceberg

# AWS IAM Policy Name for Snowflake access
IAM_POLICY_NAME=MyIcebergAccessPolicy

# AWS IAM Trust Policy External ID
TRUST_POLICY_EXTERNAL_ID=my-iceberg-external-id

# AWS IAM Role Name for Snowflake to assume
IAM_ROLE_NAME=myIcebergAccessRole

# ################################################
# Spark Demo Configuration
# ################################################

# Conda environment name for Spark demo
CONDA_ENV_NAME=iceberg-lab

# Snowflake Horizon REST Catalog endpoint
# Format: https://<account_identifier>.snowflakecomputing.com/polaris/api/catalog
SPARK_HORIZON_CATALOG_URI=https://<account_identifier>.snowflakecomputing.com/polaris/api/catalog

# Snowflake database name (this will be your catalog in Iceberg)
SPARK_CATALOG_NAME=YOUR_DATABASE_NAME

# Personal Access Token from Snowflake
# Get this from: Account Settings → Security → Personal Access Tokens
SPARK_SNOWFLAKE_PAT=YOUR_PAT_HERE

# Snowflake role to use (format: session:role:ROLE_NAME)
SPARK_HORIZON_ROLE=session:role:YOUR_ROLE_NAME

# Iceberg version for Spark packages
SPARK_ICEBERG_VERSION=1.10.0

# Jupyter notebook to open
SPARK_NOTEBOOK_PATH=tasks/python/notebook/horizon_v3_variant_spark.ipynb
