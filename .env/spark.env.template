# Spark Demo Environment Configuration Template
# Copy this file to spark.env and fill in your values:
#   cp .env/spark.env.template .env/spark.env
#
# These vars are loaded by cmd/run-spark-jupyter.sh (in addition to the shared
# .env/iceberg.env that Task already loads). The Spark interop notebook also
# reuses the shared keypair connection CLI_KEYPAIR_CONNECTION_NAME and the
# DEMO_* / AWS_REGION values from .env/iceberg.env.
#
# Auth model (two connections, same Snowflake account):
#   - CLI_KEYPAIR_CONNECTION_NAME (in iceberg.env): the shared key-pair connection
#     used to mint the Horizon REST catalog JWT via `snow connection generate-jwt`.
#   - SPARK_PASSWORD_CONNECTION_NAME (below): a password connection for the
#     spark-snowflake connector.

# ################################################
# Spark connector credentials (separate from the shared keypair connection)
# ################################################

# Password snow CLI connection used by the spark-snowflake connector.
SPARK_PASSWORD_CONNECTION_NAME=my_password_connection

# Password for the spark-snowflake connector, following the snow CLI env-var
# convention (NAME is the PASSWORD connection name uppercased). Do NOT commit a
# real value; export it in your shell instead:
#   export SNOWFLAKE_CONNECTIONS_MY_PASSWORD_CONNECTION_PASSWORD="..."

# ################################################
# Spark runtime
# ################################################

# Cloud provider for the Iceberg SDK bundle + FileIO (aws | gcp | azure).
# Even with Snowflake-managed storage, Spark reads files via cloud SDK bundles;
# match this to your Snowflake account's cloud.
SPARK_CLOUD_PROVIDER=aws

# Iceberg runtime + cloud bundle version for Spark packages.
SPARK_ICEBERG_VERSION=1.10.1

# Optional override for the notebook path (the run task defaults to the bundled notebook).
#SPARK_NOTEBOOK_PATH=tasks/snow-cli/pyutil/spark/spark_iceberg_interop.ipynb
